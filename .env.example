# Copy to .env and fill in. Keep .env out of version control.

# Admin password for the webapp /admin view.
ADMIN_PASSWORD=change-me

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# The two CTF flags. Rotate per cohort. Any format; avoid shell-breaking quotes.
FLAG_1=CTF{webapp_ssti_flag_1}
FLAG_2=CTF{backup_injection_flag_2}

# RMAP identity: the name under which keys/server_public.asc is registered on the
# group servers (the rmap-runner sends this in message 1).
RMAP_IDENTITY=Server

# Passphrase for keys/server_private.asc, if it is protected. Leave empty if not.
KEY_PASSPHRASE=
